# Source index page that contains report links
TXFNO_INDEX_URL=https://example.com/reports/index.html

# Output directory for downloaded artifacts
TXFNO_OUTPUT_DIR=./data

# ISO date override. Leave blank to use current UTC date.
TXFNO_TRADE_DATE=

# Uploader backend: local|s3
TXFNO_UPLOADER=local

# Optional destination bucket/prefix for cloud uploaders
TXFNO_UPLOAD_BUCKET=
TXFNO_UPLOAD_PREFIX=txfno

# Log level: DEBUG|INFO|WARNING|ERROR
TXFNO_LOG_LEVEL=INFO
